# Copy values into an ignored local .env file. Never commit credentials.
NODE_ENV=development
API_PORT=4000
API_BASE_URL=http://localhost:4000/api/v1
MONGODB_URI=mongodb://localhost:27017/shopsphere?replicaSet=rs0
ACCESS_TOKEN_SECRET=replace-with-a-random-secret-of-at-least-32-bytes
REFRESH_TOKEN_SECRET=replace-with-a-different-random-secret-of-at-least-32-bytes
WEB_ORIGINS=http://localhost:5173
UPLOAD_STORAGE=local
UPLOAD_LOCAL_DIRECTORY=./.local-uploads
PAYMENT_PROVIDER=development
PAYMENT_WEBHOOK_SECRET=
AI_PROVIDER=development
AI_API_KEY=
AI_MODEL=