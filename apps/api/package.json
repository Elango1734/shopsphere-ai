{
  "name": "@shopsphere/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "ShopSphere AI API: MongoDB/Mongoose data layer and the Express REST API that hosts it.",
  "engines": {
    "node": ">=22 <23"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "NODE_OPTIONS=--experimental-vm-modules npx jest",
    "test:unit": "NODE_OPTIONS=--experimental-vm-modules npx jest tests/unit tests/models",
    "test:integration": "NODE_OPTIONS=--experimental-vm-modules npx jest tests/integration",
    "test:http": "NODE_OPTIONS=--experimental-vm-modules npx jest tests/http",
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "build": "tsc -p tsconfig.build.json && mkdir -p dist/openapi && cp src/openapi/openapi.yaml dist/openapi/openapi.yaml",
    "db:indexes": "tsx src/db/scripts/syncIndexes.ts",
    "db:indexes:verify": "tsx src/db/scripts/verifyIndexes.ts",
    "db:migrate": "tsx src/db/migrations/run.ts",
    "db:seed": "tsx src/db/seed/run.ts",
    "db:seed:reset": "tsx src/db/seed/run.ts --reset",
    "db:set-admin-credentials": "tsx src/db/scripts/setAdminCredentials.ts"
  },
  "dependencies": {
    "mongoose": "8.13.2",
    "dotenv": "16.4.7",
    "zod": "3.24.2",
    "argon2": "0.41.1",
    "nanoid": "5.1.5",
    "express": "5.1.0",
    "helmet": "8.0.0",
    "cors": "2.8.5",
    "express-rate-limit": "7.5.0",
    "jsonwebtoken": "9.0.2",
    "cookie-parser": "1.4.7",
    "pino": "9.6.0",
    "pino-http": "10.4.0",
    "swagger-ui-express": "5.0.1",
    "yaml": "2.7.0",
    "@shopsphere/shared-types": "0.1.0",
    "@shopsphere/validation": "0.1.0"
  },
  "devDependencies": {
    "typescript": "5.8.3",
    "tsx": "4.19.3",
    "jest": "29.7.0",
    "ts-jest": "29.2.6",
    "@types/jest": "29.5.14",
    "@types/node": "22.13.10",
    "@types/express": "5.0.0",
    "@types/cors": "2.8.17",
    "@types/cookie-parser": "1.4.8",
    "@types/jsonwebtoken": "9.0.7",
    "@types/supertest": "6.0.2",
    "@types/swagger-ui-express": "4.1.7",
    "supertest": "7.1.0",
    "mongodb-memory-server": "10.1.4"
  }
}
